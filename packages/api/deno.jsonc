{
  "name": "@commonfabric/api",
  "tasks": {
    // --no-check: this package is type-checked by `deno task check` (tasks/check.sh).
    // The baseline profile keeps the TypeScript wrapper and path mappings covered.
    "test": "deno test --no-check --allow-read test/**/*.test.ts && deno run -A perf/run-tsc.ts --project perf/tsconfig.baseline.json --pretty false",
    "profile-types": "deno run -A perf/run-benchmarks.ts"
  },
  "imports": {
    // Dependency guide: ../../docs/development/DEPENDENCIES.md
    "typescript": "npm:typescript@6.0.3"
  },
  "exports": {
    ".": "./index.ts",
    "./cfc-authoring": "./cfc-authoring.ts",
    "./cfc": "./cfc.ts",
    "./schema": "./schema.ts"
  }
}
