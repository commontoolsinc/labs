{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "pretty": false,
    "incremental": false,
    "paths": {
      "@/*": [
        "../../data-model/src/*"
      ],
      "@commonfabric/api": [
        "../index.ts"
      ],
      "@commonfabric/data-model/deep-freeze": [
        "../../data-model/src/deep-freeze.ts"
      ],
      "@commonfabric/utils/*": [
        "../../utils/src/*"
      ],
      "commonfabric": [
        "../index.ts"
      ]
    }
  }
}
