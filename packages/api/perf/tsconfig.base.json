{
  "compilerOptions": {
    // `data-model` requires `Error.isError()`, which is introduced in
    // ES2026. As of this writing, TypeScript does not recognize `es2026`,
    // so we use `ESNext` instead.
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "pretty": false,
    "incremental": false,
    "paths": {
      "@/*": [
        "../../data-model/src/*"
      ],
      "@commonfabric/api": [
        "../index.ts"
      ],
      "@commonfabric/data-model/api": [
        "../../data-model/src/api.ts"
      ],
      "@commonfabric/data-model/deep-freeze": [
        "../../data-model/src/deep-freeze.ts"
      ],
      "@commonfabric/utils/*": [
        "../../utils/src/*"
      ],
      "commonfabric": [
        "../index.ts"
      ]
    }
  }
}
