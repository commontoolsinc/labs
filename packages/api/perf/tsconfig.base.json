{
  "compilerOptions": {
    // What belongs here is `ES2026`, the version that defines
    // `Error.isError()`. The pinned TypeScript does not recognize that
    // target, and declares the method only in its `esnext` lib.
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "pretty": false,
    "incremental": false,
    "paths": {
      "@/*": [
        "../../data-model/src/*"
      ],
      "@commonfabric/api": [
        "../index.ts"
      ],
      "@commonfabric/data-model/api": [
        "../../data-model/src/api.ts"
      ],
      "@commonfabric/data-model/deep-freeze": [
        "../../data-model/src/deep-freeze.ts"
      ],
      "@commonfabric/utils/*": [
        "../../utils/src/*"
      ],
      "commonfabric": [
        "../index.ts"
      ]
    }
  }
}
