{
  "schema": "commonfabric.agents-host.config.v1",
  "collectionIntervalMs": 900000,
  "sources": [
    {
      "id": "codex",
      "driver": "codex-app-server",
      "enabled": true,
      "codexTransport": "stdio",
      "cwd": "/path/to/worktree",
      "allowDangerFullAccess": false
    }
  ]
}
