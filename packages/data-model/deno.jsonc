{
  "name": "@commonfabric/data-model",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    // Dependency guide: ../../docs/development/DEPENDENCIES.md
    "@/": "./src/",
    "@node/crypto": "node:crypto"
  },
  "tasks": {
    "check": "deno check .",
    "just-test": {
      "description": "Run unit tests",
      // `--allow-read` so that a test may start a `Worker`, which reads the
      // worker's module from disk. `codec-realm`'s round trips go through a
      // real one, that being the boundary the format exists for.
      "command": "deno test --allow-read"
    },
    "bench": {
      "description": "Run benchmarks",
      // `--allow-read` so that a benchmark may start a `Worker`, which reads
      // the worker's module from disk. `codec-realm`'s IPC benchmark measures
      // a real `postMessage()` crossing, that being the boundary the format
      // exists for.
      "command": "deno bench --allow-read"
    },
    "test": {
      "description": "Type check & run tests",
      "dependencies": [
        "check",
        "just-test"
      ]
    }
  },
  "test": {
    "include": [
      "test/**/*.test.ts"
    ]
  },
  "exports": {
    "./SchemaAndHash": "./src/SchemaAndHash.ts",
    "./cell-rep": "./src/cell-rep.ts",
    "./codec-common": "./src/codec-common/index.ts",
    "./codec-json": "./src/codec-json/index.ts",
    "./codec-realm": "./src/codec-realm/index.ts",
    "./codecs": "./src/codecs.ts",
    "./data-uri-codec": "./src/data-uri-codec.ts",
    "./deep-freeze": "./src/deep-freeze.ts",
    "./fabric-bases": "./src/fabric-bases/index.ts",
    "./fabric-instances": "./src/fabric-instances/index.ts",
    "./fabric-primitives": "./src/fabric-primitives/index.ts",
    "./fabric-value": "./src/fabric-value.ts",
    "./frozen-builtins": "./src/frozen-builtins.ts",
    "./native-type-tags": "./src/native-type-tags.ts",
    "./schema-hash": "./src/schema-hash.ts",
    "./schema-utils": "./src/schema-utils.ts",
    "./value-clone": "./src/value-clone.ts",
    "./value-debug": "./src/value-debug.ts",
    "./value-hash": "./src/value-hash.ts"
  }
}
