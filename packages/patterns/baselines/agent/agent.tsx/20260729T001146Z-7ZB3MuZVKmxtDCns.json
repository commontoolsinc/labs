{
  "pattern": "agent/agent.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {
      "agentName": {
        "type": "string",
        "default": "Unnamed Agent",
        "asCell": [
          "cell"
        ]
      },
      "directive": {
        "type": "string",
        "default": "",
        "asCell": [
          "cell"
        ]
      },
      "enabled": {
        "type": "boolean",
        "default": true,
        "asCell": [
          "cell"
        ]
      },
      "learned": {
        "type": "string",
        "default": "",
        "asCell": [
          "cell"
        ]
      },
      "status": {
        "$ref": "#/$defs/AgentStatus",
        "default": "idle",
        "asCell": [
          "cell"
        ]
      },
      "lastRun": {
        "type": "string",
        "default": "",
        "asCell": [
          "cell"
        ]
      },
      "lastRunSummary": {
        "type": "string",
        "default": "",
        "asCell": [
          "cell"
        ]
      },
      "isAgent": {
        "type": "boolean",
        "default": true
      }
    },
    "$defs": {
      "AgentStatus": {
        "enum": [
          "idle",
          "running",
          "error"
        ]
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "agentName": {
        "type": "string"
      },
      "directive": {
        "type": "string"
      },
      "enabled": {
        "type": "boolean"
      },
      "learned": {
        "type": "string"
      },
      "status": {
        "$ref": "#/$defs/AgentStatus"
      },
      "lastRun": {
        "type": "string"
      },
      "lastRunSummary": {
        "type": "string"
      },
      "isAgent": {
        "type": "boolean"
      },
      "summary": {
        "type": "string"
      },
      "setDirective": {
        "asCell": [
          "stream"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          }
        },
        "required": [
          "value"
        ]
      },
      "setLearned": {
        "asCell": [
          "stream"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          }
        },
        "required": [
          "value"
        ]
      },
      "appendLearned": {
        "asCell": [
          "stream"
        ],
        "type": "object",
        "properties": {
          "entry": {
            "type": "string"
          }
        },
        "required": [
          "entry"
        ]
      },
      "toggleEnabled": {
        "asCell": [
          "stream",
          "opaque"
        ]
      },
      "markRunning": {
        "asCell": [
          "stream",
          "opaque"
        ]
      },
      "markIdle": {
        "asCell": [
          "stream"
        ],
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "learned": {
            "type": "string"
          }
        },
        "required": [
          "summary"
        ]
      },
      "markError": {
        "asCell": [
          "stream"
        ],
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "summary"
        ]
      },
      "$NAME": {
        "type": "string"
      },
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      }
    },
    "required": [
      "agentName",
      "directive",
      "enabled",
      "learned",
      "status",
      "lastRun",
      "lastRunSummary",
      "isAgent",
      "summary",
      "setDirective",
      "setLearned",
      "appendLearned",
      "toggleEnabled",
      "markRunning",
      "markIdle",
      "markError",
      "$NAME",
      "$UI"
    ],
    "description": "An #agent piece — autonomous worker with directive, learned state, and status.",
    "tags": [
      "agent"
    ],
    "$defs": {
      "AgentStatus": {
        "enum": [
          "idle",
          "running",
          "error"
        ]
      }
    }
  }
