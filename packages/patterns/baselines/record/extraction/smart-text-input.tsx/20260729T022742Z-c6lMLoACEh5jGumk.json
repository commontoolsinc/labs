{
  "argumentSchema": {
    "properties": {
      "$value": true,
      "maxImageSizeBytes": {
        "type": "number"
      },
      "maxTextFileSizeBytes": {
        "type": "number"
      },
      "placeholder": {
        "type": "string"
      },
      "rows": {
        "type": "number"
      }
    },
    "required": [
      "$value"
    ],
    "type": "object"
  },
  "pattern": "record/extraction/smart-text-input.tsx",
  "resultSchema": {
    "$defs": {
      "JSXElement": {
        "anyOf": [
          {
            "$ref": "https://commonfabric.org/schemas/vnode.json"
          },
          {
            "$ref": "#/$defs/UIRenderable"
          },
          {
            "properties": {},
            "type": "object"
          }
        ]
      },
      "UIRenderable": {
        "properties": {
          "$UI": {
            "$ref": "https://commonfabric.org/schemas/vnode.json"
          }
        },
        "required": [
          "$UI"
        ],
        "type": "object"
      }
    },
    "properties": {
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "pending": {
        "type": "boolean"
      },
      "ui": {
        "properties": {
          "buttons": {
            "$ref": "#/$defs/JSXElement"
          },
          "complete": {
            "$ref": "#/$defs/JSXElement"
          },
          "preview": {
            "$ref": "#/$defs/JSXElement"
          },
          "textArea": {
            "$ref": "#/$defs/JSXElement"
          }
        },
        "required": [
          "complete",
          "textArea",
          "buttons",
          "preview"
        ],
        "type": "object"
      },
      "value": {
        "type": "string"
      }
    },
    "required": [
      "value",
      "pending",
      "error",
      "ui"
    ],
    "type": "object"
  }
}
