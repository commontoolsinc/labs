{
  "pattern": "profile-roster-live-demo.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {
      "roster": {
        "$ref": "#/$defs/Roster",
        "default": {
          "participants": []
        },
        "scope": "space"
      },
      "viewer": {
        "$ref": "#/$defs/ViewerState",
        "default": {},
        "scope": "user"
      }
    },
    "$defs": {
      "ViewerState": {
        "type": "object",
        "properties": {
          "joined": {
            "type": "boolean"
          }
        }
      },
      "Roster": {
        "type": "object",
        "properties": {
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Participant"
            },
            "default": []
          }
        },
        "required": [
          "participants"
        ]
      },
      "Participant": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "avatar": {
                "type": "string"
              },
              "bio": {
                "type": "string"
              }
            },
            "asCell": [
              "cell"
            ],
            "description": "Live link to the contributor's profile cell — stable identity + live data."
          },
          "name": {
            "type": "string",
            "description": "Display name, snapshotted at join time (durable label; survives even if the live cell is momentarily unresolved on first render)."
          },
          "joinedAt": {
            "type": "number"
          }
        },
        "required": [
          "profile",
          "name",
          "joinedAt"
        ]
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "roster": {
        "$ref": "#/$defs/Roster",
        "default": {
          "participants": []
        },
        "scope": "space"
      },
      "viewer": {
        "$ref": "#/$defs/ViewerState",
        "default": {},
        "scope": "user"
      },
      "participantCount": {
        "type": "number"
      },
      "join": {
        "asCell": [
          "stream"
        ],
        "$ref": "#/$defs/JoinEvent"
      },
      "$NAME": {
        "type": "string"
      },
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      }
    },
    "required": [
      "roster",
      "viewer",
      "participantCount",
      "join",
      "$NAME",
      "$UI"
    ],
    "$defs": {
      "JoinEvent": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "ViewerState": {
        "type": "object",
        "properties": {
          "joined": {
            "type": "boolean"
          }
        }
      },
      "Roster": {
        "type": "object",
        "properties": {
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Participant"
            },
            "default": []
          }
        },
        "required": [
          "participants"
        ]
      },
      "Participant": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "avatar": {
                "type": "string"
              },
              "bio": {
                "type": "string"
              }
            },
            "description": "Live link to the contributor's profile cell — stable identity + live data."
          },
          "name": {
            "type": "string",
            "description": "Display name, snapshotted at join time (durable label; survives even if the live cell is momentarily unresolved on first render)."
          },
          "joinedAt": {
            "type": "number"
          }
        },
        "required": [
          "profile",
          "name",
          "joinedAt"
        ]
      }
    }
  }
}
