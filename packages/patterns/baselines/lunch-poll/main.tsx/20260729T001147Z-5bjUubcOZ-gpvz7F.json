          "greens": {
            "type": "number"
          },
          "yellows": {
            "type": "number"
          },
          "reds": {
            "type": "number"
          }
        },
        "required": [
          "title",
          "visits",
          "greens",
          "yellows",
          "reds"
        ]
      },
      "HistoryEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "loggedByName": {
            "type": "string"
          },
          "loggedBy": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/User"
              }
            ]
          },
          "wentAt": {
            "type": "number"
          },
          "votes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/VoteSnapshot"
            }
          }
        },
        "required": [
          "id",
          "title",
          "loggedByName",
          "loggedBy",
          "wentAt",
          "votes"
        ]
      },
      "VoteSnapshot": {
        "type": "object",
        "properties": {
