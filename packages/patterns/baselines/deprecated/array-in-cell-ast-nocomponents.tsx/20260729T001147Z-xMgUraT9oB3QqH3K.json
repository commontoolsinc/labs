{
  "pattern": "deprecated/array-in-cell-ast-nocomponents.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "default": "untitled"
      },
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Item"
        },
        "default": []
      }
    },
    "required": [
      "title",
      "items"
    ],
    "$defs": {
      "Item": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "text"
        ]
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "$NAME": {
        "type": "string"
      },
      "$UI": {
        "$ref": "#/$defs/JSXElement"
      },
      "title": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Item"
        }
      },
      "addItem": {
        "asCell": [
          "stream"
        ],
        "$ref": "#/$defs/InputEventType"
      }
    },
    "required": [
      "$NAME",
      "$UI",
      "title",
      "items",
      "addItem"
    ],
    "$defs": {
      "InputEventType": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        "required": [
          "detail"
        ]
      },
      "Item": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "text"
        ]
      },
      "JSXElement": {
        "anyOf": [
          {
            "$ref": "https://commonfabric.org/schemas/vnode.json"
          },
          {
            "$ref": "#/$defs/UIRenderable"
          },
          {
            "type": "object",
            "properties": {}
          }
        ]
      },
      "UIRenderable": {
        "type": "object",
        "properties": {
          "$UI": {
            "$ref": "https://commonfabric.org/schemas/vnode.json"
          }
        },
        "required": [
          "$UI"
        ]
      }
    }
  }
}
