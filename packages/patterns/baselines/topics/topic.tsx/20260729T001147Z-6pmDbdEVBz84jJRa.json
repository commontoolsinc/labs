{
  "pattern": "topics/topic.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "default": "",
        "asCell": [
          "cell"
        ]
      },
      "body": {
        "type": "string",
        "default": "",
        "asCell": [
          "cell"
        ],
        "description": "The topic's living document: durable conclusions get folded up into the\nbody; the comment thread below holds the deliberation."
      },
      "comments": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/TopicComment"
        },
        "default": [],
        "asCell": [
          "cell"
        ]
      },
      "links": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/TopicLink"
        },
        "default": [],
        "asCell": [
          "cell"
        ]
      },
      "createdAt": {
        "type": "number",
        "default": 0
      },
      "createdBy": {
        "$ref": "#/$defs/TopicAuthor"
      },
      "createdByName": {
        "type": "string",
        "default": ""
      },
      "myName": {
        "type": "string",
        "default": "",
        "asCell": [
          {
            "kind": "cell",
            "scope": "user"
          }
        ]
      },
      "bodyUpdatedBy": {
        "$ref": "#/$defs/TopicAuthor",
        "default": {
          "kind": "person",
          "name": ""
        },
        "asCell": [
          "cell"
        ]
      },
      "bodyUpdatedAt": {
        "type": "number",
        "default": 0,
        "asCell": [
          "cell"
        ]
      },
      "mentionable": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/TopicReference"
        },
        "default": [],
        "asCell": [
          "cell"
        ],
        "description": "The board's own topics list — the sibling set for this topic's derived\ncrossrefs and the mention universe for authoring. A reference to the\ntracker's array, wired at creation like `myName` (and backfillable as a\none-time link-bind on pieces created before it existed). Absent, the\ndetail page simply derives no connections."
      }
    },
    "$defs": {
      "TopicReference": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/TopicComment"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/TopicLink"
            }
          },
          "createdAt": {
            "type": "number"
          },
          "createdBy": {
            "anyOf": [
              {
                "$ref": "#/$defs/TopicAuthor"
              },
              {
                "type": "undefined"
              }
            ],
            "default": {
              "kind": "person",
              "name": ""
            },
            "description": "Mixed-version list projections can resolve an older sibling's absent\npath as undefined. Fabric shapes that absence to this inert legacy\nsentinel at the list boundary; newly computed non-empty authorship remains\na structured TopicAuthor."
          },
          "createdByName": {
            "type": "string"
          },
          "bodyUpdatedBy": {
            "anyOf": [
              {
                "type": "undefined"
              },
              {
                "$ref": "#/$defs/TopicAuthor"
              }
            ]
          },
          "bodyUpdatedAt": {
            "type": [
              "number",
              "undefined"
            ]
          },
          "commentCount": {
            "type": [
              "number",
              "undefined"
            ],
            "default": 0,
            "description": "Cold mixed-version references can expose an unresolved computed path as\nexplicit undefined. Shape it to zero until the sibling starts."
          },
          "lastActivityAt": {
            "type": [
              "number",
              "undefined"
            ],
            "default": 0,
            "description": "Max of creation, comments, body saves, and link additions."
          },
          "addComment": {
            "$ref": "#/$defs/AddCommentEvent",
            "asCell": [
              "stream"
            ]
          },
          "addLink": {
            "$ref": "#/$defs/AddLinkEvent",
            "asCell": [
              "stream"
            ]
          },
          "setBody": {
            "$ref": "#/$defs/SetBodyEvent",
            "asCell": [
              "stream"
            ]
          },
          "$NAME": {
            "type": [
              "string",
              "undefined"
            ],
            "default": "",
            "description": "Like the other derived display fields, a cold retained sibling may not\nhave produced this path yet. Its persisted title remains authoritative."
          }
        },
        "required": [
          "title",
          "body",
          "comments",
          "links",
          "createdAt",
          "createdByName",
          "commentCount",
          "lastActivityAt",
          "addComment",
          "addLink",
          "setBody",
          "$NAME"
        ]
      },
      "SetBodyEvent": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          },
          "agentName": {
            "type": "string",
            "description": "Explicit content-level signature for an agent using its human user's\nidentity key. Optional only so callers of the previous deployed schema\nremain valid; new callers must provide a non-blank name."
          }
        },
        "required": [
          "body"
        ]
      },
      "AddLinkEvent": {
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/$defs/TopicLinkKind"
          },
          "url": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "agentName": {
            "type": "string",
            "description": "Explicit content-level signature for an agent using its human user's\nidentity key. Optional only so callers of the previous deployed schema\nremain valid; new callers must provide a non-blank name."
          }
        },
        "required": [
          "kind",
          "url",
          "label"
        ]
      },
      "TopicLinkKind": {
        "enum": [
          "pr",
          "topic",
          "session",
          "web"
        ]
      },
      "AddCommentEvent": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          },
          "agentName": {
            "type": "string",
            "description": "Explicit content-level signature for an agent using its human user's\nidentity key. Optional only so callers of the previous deployed schema\nremain valid; new callers must provide a non-blank name."
          }
        },
        "required": [
          "body"
        ]
      },
      "TopicAuthor": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "person",
              "agent"
            ]
          },
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name"
        ]
      },
      "TopicLink": {
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/$defs/TopicLinkKind",
            "default": "web"
          },
          "url": {
            "type": "string",
            "default": ""
          },
          "label": {
            "type": "string",
            "default": ""
          },
          "addedBy": {
            "$ref": "#/$defs/TopicAuthor"
          },
          "addedAt": {
            "type": "number"
          }
        },
        "required": [
          "kind",
          "url",
          "label"
        ]
      },
      "TopicComment": {
        "type": "object",
        "properties": {
          "author": {
            "$ref": "#/$defs/TopicAuthor",
            "description": "Snapshot taken at write time (profile enrichment comes later; never gate\nauthorship on a profile wish — CT-1879). Comments carry no minted id:\narray elements have stable entity identity; future editing addresses\nelements by reference (`equals()`), not by a synthetic key."
          },
          "authorName": {
            "type": "string",
            "default": ""
          },
          "body": {
            "type": "string",
            "default": ""
          },
          "sentAt": {
            "type": "number",
            "default": 0
          }
        },
        "required": [
          "authorName",
          "body",
          "sentAt"
        ]
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "commentDraft": {
        "type": "string",
        "description": "Session-local composer/edit state. These controls belong to a direct Topic\ninstance, not the shared TopicPiece projection used by the tracker's list."
      },
      "bodyDraft": {
        "type": "string"
      },
      "editingBody": {
        "type": "boolean",
        "scope": "session"
      },
      "linkUrlDraft": {
        "type": "string"
      },
      "linkLabelDraft": {
        "type": "string"
      },
      "linkKindDraft": {
        "$ref": "#/$defs/TopicLinkKind"
      },
      "submitComment": {
        "asCell": [
          "stream",
          "opaque"
        ],
        "description": "UI affordances as streams: composer submit, body edit lifecycle."
      },
      "startEditBody": {
        "asCell": [
          "stream",
          "opaque"
        ]
      },
      "saveBody": {
        "asCell": [
          "stream",
          "opaque"
        ]
      },
      "cancelEditBody": {
        "asCell": [
          "stream",
          "opaque"
        ]
      },
      "submitLink": {
        "asCell": [
          "stream",
          "opaque"
        ]
      },
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      },
      "crossrefs": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "refsOut": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/TopicReference"
                }
              },
              "referencedBy": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/TopicReference"
                }
              }
            },
            "required": [
              "refsOut",
              "referencedBy"
            ]
          },
          {
            "type": "undefined"
          }
        ],
        "default": {
          "refsOut": [],
          "referencedBy": []
        },
        "description": "This topic's own place in the board's prose graph, derived read-side\nfrom `mentionable` (the sibling pieces it links, resolved from the\nboard's own list). Both sets stay empty until `mentionable` is wired.\nOptional (2026-07-21 deploy): pieces healed before their `mentionable`\nlink exists carry a session-scoped crossrefs indirection that resolves\nundefined outside the minting session; the list projection must accept\nthat rather than fail argument validation."
      },
      "title": {
        "type": "string"
      },
      "body": {
        "type": "string"
      },
      "comments": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/TopicComment"
        }
      },
      "links": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/TopicLink"
        }
      },
      "createdAt": {
        "type": "number"
      },
      "createdBy": {
        "anyOf": [
          {
            "$ref": "#/$defs/TopicAuthor"
          },
          {
            "type": "undefined"
          }
        ],
        "default": {
          "kind": "person",
          "name": ""
        },
        "description": "Mixed-version list projections can resolve an older sibling's absent\npath as undefined. Fabric shapes that absence to this inert legacy\nsentinel at the list boundary; newly computed non-empty authorship remains\na structured TopicAuthor."
      },
      "createdByName": {
        "type": "string"
      },
      "bodyUpdatedBy": {
        "anyOf": [
          {
            "type": "undefined"
          },
          {
            "$ref": "#/$defs/TopicAuthor"
          }
        ]
      },
      "bodyUpdatedAt": {
        "type": [
          "number",
          "undefined"
        ]
      },
      "commentCount": {
        "type": [
          "number",
          "undefined"
        ],
        "default": 0,
        "description": "Cold mixed-version references can expose an unresolved computed path as\nexplicit undefined. Shape it to zero until the sibling starts."
      },
      "lastActivityAt": {
        "type": [
          "number",
          "undefined"
        ],
        "default": 0,
        "description": "Max of creation, comments, body saves, and link additions."
      },
      "addComment": {
        "asCell": [
          "stream"
        ],
        "$ref": "#/$defs/AddCommentEvent"
      },
      "addLink": {
        "asCell": [
          "stream"
        ],
        "$ref": "#/$defs/AddLinkEvent"
      },
      "setBody": {
        "asCell": [
          "stream"
        ],
        "$ref": "#/$defs/SetBodyEvent"
      },
      "$NAME": {
        "type": [
          "string",
          "undefined"
        ],
        "default": "",
        "description": "Like the other derived display fields, a cold retained sibling may not\nhave produced this path yet. Its persisted title remains authoritative."
      }
    },
    "required": [
      "commentDraft",
      "bodyDraft",
      "editingBody",
      "linkUrlDraft",
      "linkLabelDraft",
      "linkKindDraft",
      "submitComment",
      "startEditBody",
      "saveBody",
      "cancelEditBody",
      "submitLink",
      "$UI",
      "title",
      "body",
      "comments",
      "links",
      "createdAt",
      "createdByName",
      "commentCount",
      "lastActivityAt",
      "addComment",
      "addLink",
      "setBody",
      "$NAME"
    ],
    "description": "The complete result available when a Topic is instantiated directly.",
    "$defs": {
      "SetBodyEvent": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          },
          "agentName": {
            "type": "string",
            "description": "Explicit content-level signature for an agent using its human user's\nidentity key. Optional only so callers of the previous deployed schema\nremain valid; new callers must provide a non-blank name."
          }
        },
        "required": [
          "body"
        ]
      },
      "AddLinkEvent": {
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/$defs/TopicLinkKind"
          },
          "url": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "agentName": {
            "type": "string",
            "description": "Explicit content-level signature for an agent using its human user's\nidentity key. Optional only so callers of the previous deployed schema\nremain valid; new callers must provide a non-blank name."
          }
        },
        "required": [
          "kind",
          "url",
          "label"
        ]
      },
      "AddCommentEvent": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          },
          "agentName": {
            "type": "string",
            "description": "Explicit content-level signature for an agent using its human user's\nidentity key. Optional only so callers of the previous deployed schema\nremain valid; new callers must provide a non-blank name."
          }
        },
        "required": [
          "body"
        ]
      },
      "TopicAuthor": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "person",
              "agent"
            ]
          },
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name"
        ]
      },
      "TopicLink": {
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/$defs/TopicLinkKind",
            "default": "web"
          },
          "url": {
            "type": "string",
            "default": ""
          },
          "label": {
            "type": "string",
            "default": ""
          },
          "addedBy": {
            "$ref": "#/$defs/TopicAuthor"
          },
          "addedAt": {
            "type": "number"
          }
        },
        "required": [
          "kind",
          "url",
          "label"
        ]
      },
      "TopicComment": {
        "type": "object",
        "properties": {
          "author": {
            "$ref": "#/$defs/TopicAuthor",
            "description": "Snapshot taken at write time (profile enrichment comes later; never gate\nauthorship on a profile wish — CT-1879). Comments carry no minted id:\narray elements have stable entity identity; future editing addresses\nelements by reference (`equals()`), not by a synthetic key."
          },
          "authorName": {
            "type": "string",
            "default": ""
          },
          "body": {
            "type": "string",
            "default": ""
          },
          "sentAt": {
            "type": "number",
            "default": 0
          }
        },
        "required": [
          "authorName",
          "body",
          "sentAt"
        ]
      },
      "TopicReference": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/TopicComment"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/TopicLink"
            }
          },
          "createdAt": {
            "type": "number"
          },
          "createdBy": {
            "anyOf": [
              {
                "$ref": "#/$defs/TopicAuthor"
              },
              {
                "type": "undefined"
              }
            ],
            "default": {
              "kind": "person",
              "name": ""
            },
            "description": "Mixed-version list projections can resolve an older sibling's absent\npath as undefined. Fabric shapes that absence to this inert legacy\nsentinel at the list boundary; newly computed non-empty authorship remains\na structured TopicAuthor."
          },
          "createdByName": {
            "type": "string"
          },
          "bodyUpdatedBy": {
            "anyOf": [
              {
                "type": "undefined"
              },
              {
                "$ref": "#/$defs/TopicAuthor"
              }
            ]
          },
          "bodyUpdatedAt": {
            "type": [
              "number",
              "undefined"
            ]
          },
          "commentCount": {
            "type": [
              "number",
              "undefined"
            ],
            "default": 0,
            "description": "Cold mixed-version references can expose an unresolved computed path as\nexplicit undefined. Shape it to zero until the sibling starts."
          },
          "lastActivityAt": {
            "type": [
              "number",
              "undefined"
            ],
            "default": 0,
            "description": "Max of creation, comments, body saves, and link additions."
          },
          "addComment": {
            "asCell": [
              "stream"
            ],
            "$ref": "#/$defs/AddCommentEvent"
          },
          "addLink": {
            "asCell": [
              "stream"
            ],
            "$ref": "#/$defs/AddLinkEvent"
          },
          "setBody": {
            "asCell": [
              "stream"
            ],
            "$ref": "#/$defs/SetBodyEvent"
          },
          "$NAME": {
            "type": [
              "string",
              "undefined"
            ],
            "default": "",
            "description": "Like the other derived display fields, a cold retained sibling may not\nhave produced this path yet. Its persisted title remains authoritative."
          }
        },
        "required": [
          "title",
          "body",
          "comments",
          "links",
          "createdAt",
          "createdByName",
          "commentCount",
          "lastActivityAt",
          "addComment",
          "addLink",
          "setBody",
          "$NAME"
        ]
      },
      "TopicLinkKind": {
        "enum": [
          "pr",
          "topic",
          "session",
          "web"
        ]
      }
    }
  }
}
