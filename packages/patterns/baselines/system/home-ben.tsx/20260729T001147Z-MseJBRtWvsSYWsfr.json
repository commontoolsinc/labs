{
  "pattern": "system/home-ben.tsx",
  "argumentSchema": false,
  "resultSchema": {
    "type": "object",
    "properties": {
      "$NAME": {
        "type": "string",
        "enum": [
          "Home"
        ]
      },
      "$UI": {
        "$ref": "#/$defs/JSXElement"
      },
      "favorites": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Favorite"
        }
      },
      "journal": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/JournalEntry"
        }
      },
      "spaces": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/SpaceEntry"
        }
      },
      "defaultAppUrl": {
        "type": "string"
      },
      "addFavorite": {
        "asCell": [
          "stream"
        ],
        "type": "object",
        "properties": {
          "piece": {
            "type": "object",
            "properties": {
              "$NAME": {
                "type": "string"
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "spaceName": {
            "type": "string"
          }
        },
        "required": [
          "piece"
        ]
      },
      "removeFavorite": {
        "asCell": [
          "stream"
        ],
        "type": "object",
        "properties": {
          "piece": {
            "type": "unknown"
          }
        },
        "required": [
          "piece"
        ]
      },
      "addJournalEntry": {
        "asCell": [
          "stream"
        ],
        "type": "object",
        "properties": {
          "entry": {
            "$ref": "#/$defs/JournalEntry"
          }
        },
        "required": [
          "entry"
        ]
      }
    },
    "required": [
      "$NAME",
      "$UI",
      "favorites",
      "journal",
      "spaces",
      "defaultAppUrl",
      "addFavorite",
      "removeFavorite",
      "addJournalEntry"
    ],
    "$defs": {
      "SpaceEntry": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "did": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "JournalEntry": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "number"
          },
          "eventType": {
            "type": "string"
          },
          "subject": {
            "type": "unknown"
          },
          "snapshot": {
            "$ref": "#/$defs/JournalSnapshot"
          },
          "narrative": {
            "type": "string"
          },
          "narrativePending": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "space": {
            "type": "string"
          }
        }
      },
      "JournalSnapshot": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "schemaTag": {
            "type": "string"
          },
          "valueExcerpt": {
            "type": "string"
          }
        }
      },
      "Favorite": {
        "type": "object",
        "properties": {
          "cell": {
            "type": "object",
            "properties": {
              "$NAME": {
                "type": "string"
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "userTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "spaceName": {
            "type": "string"
          }
        },
        "required": [
          "cell",
          "tags",
          "userTags"
        ]
      },
      "JSXElement": {
        "anyOf": [
          {
            "$ref": "https://commonfabric.org/schemas/vnode.json"
          },
          {
            "$ref": "#/$defs/UIRenderable"
          },
          {
            "type": "object",
            "properties": {}
          }
        ]
      },
      "UIRenderable": {
        "type": "object",
        "properties": {
          "$UI": {
            "$ref": "https://commonfabric.org/schemas/vnode.json"
          }
        },
        "required": [
          "$UI"
        ]
      }
    }
  }
}
