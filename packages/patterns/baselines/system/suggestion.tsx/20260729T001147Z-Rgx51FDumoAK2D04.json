{
  "pattern": "system/suggestion.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {
      "situation": {
        "type": "string"
      },
      "context": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "initialResults": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/SuggestionResult",
          "asCell": [
            "cell"
          ]
        },
        "default": []
      }
    },
    "required": [
      "situation",
      "context",
      "initialResults"
    ],
    "$defs": {
      "SuggestionResult": {
        "type": "object",
        "properties": {
          "$NAME": {
            "type": "string"
          }
        }
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "result": {
        "anyOf": [
          {
            "type": "undefined"
          },
          {
            "$ref": "#/$defs/SuggestionResult"
          }
        ]
      },
      "candidates": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/SuggestionResult"
        }
      },
      "error": true,
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      }
    },
    "required": [
      "result",
      "candidates",
      "$UI"
    ],
    "$defs": {
      "SuggestionResult": {
        "type": "object",
        "properties": {
          "$NAME": {
            "type": "string"
          }
        }
      }
    }
  }
}
