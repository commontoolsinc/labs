{
  "pattern": "system/summary-index.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "entries": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/SummaryIndexEntry"
        }
      },
      "search": {
        "type": "object",
        "properties": {
          "pattern": {
            "$ref": "#/$defs/Pattern"
          },
          "extraParams": {
            "type": "object",
            "properties": {
              "entries": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SummaryIndexEntry"
                }
              }
            },
            "required": [
              "entries"
            ]
          },
          "useResultSchemaForObservation": {
            "type": "boolean"
          }
        },
        "required": [
          "pattern",
          "extraParams"
        ]
      }
    },
    "required": [
      "entries",
      "search"
    ],
    "$defs": {
      "Pattern": {
        "type": "object",
        "properties": {
          "argumentSchema": true,
          "resultSchema": true,
          "defaultScope": {
            "$ref": "#/$defs/CellScope"
          }
        },
        "required": [
          "argumentSchema",
          "resultSchema"
        ]
      },
      "CellScope": {
        "enum": [
          "space",
          "user",
          "session"
        ]
      },
      "SummaryIndexEntry": {
        "type": "object",
        "properties": {
          "piece": {
            "$ref": "#/$defs/SummarizablePiece"
          },
          "summary": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "piece",
          "summary",
          "name"
        ]
      },
      "SummarizablePiece": {
        "type": "object",
        "properties": {
          "isHidden": {
            "type": "boolean"
          },
          "isMentionable": {
            "type": "boolean"
          },
          "mentioned": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/MentionablePiece"
            }
          },
          "backlinks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/MentionablePiece"
            }
          },
          "mentionable": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/MentionablePiece"
                }
              },
              {
                "type": "object",
                "properties": {}
              }
            ]
          },
          "$NAME": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "description": "Type for pieces used in the mentionable/backlinks system.\n\nNote: While `mentioned` and `backlinks` are typed as required for structural\ncompatibility, at runtime most pieces don't actually have these fields.\nOnly patterns like notes and calendar events define them. The computeIndex\nfunction safely handles pieces that lack these fields.",
        "$comment": "Docs inherited from intersection constituents. Missing docs for: { summary?: string | undefined; }."
      },
      "MentionablePiece": {
        "type": "object",
        "properties": {
          "isHidden": {
            "type": "boolean"
          },
          "isMentionable": {
            "type": "boolean"
          },
          "mentioned": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/MentionablePiece"
            }
          },
          "backlinks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/MentionablePiece"
            }
          },
          "mentionable": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/MentionablePiece"
                }
              },
              {
                "type": "object",
                "properties": {}
              }
            ]
          },
          "$NAME": {
            "type": "string"
          }
        }
      }
    }
  }
}
