{
  "pattern": "system/suggestion-history.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "entries": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/SuggestionHistoryEntry"
        }
      },
      "search": {
        "type": "object",
        "properties": {
          "pattern": {
            "$ref": "#/$defs/Pattern"
          },
          "extraParams": {
            "type": "object",
            "properties": {
              "entries": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SuggestionHistoryEntry"
                }
              }
            },
            "required": [
              "entries"
            ]
          },
          "useResultSchemaForObservation": {
            "type": "boolean"
          }
        },
        "required": [
          "pattern",
          "extraParams"
        ]
      },
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      }
    },
    "required": [
      "entries",
      "search",
      "$UI"
    ],
    "$defs": {
      "Pattern": {
        "type": "object",
        "properties": {
          "argumentSchema": true,
          "resultSchema": true,
          "defaultScope": {
            "$ref": "#/$defs/CellScope"
          }
        },
        "required": [
          "argumentSchema",
          "resultSchema"
        ]
      },
      "CellScope": {
        "enum": [
          "user",
          "space",
          "session"
        ]
      },
      "SuggestionHistoryEntry": {
        "type": "object",
        "properties": {
          "result": {},
          "messages": {
            "type": "array",
            "items": true
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": [
          "result",
          "messages",
          "timestamp"
        ]
      }
    }
  }
}
