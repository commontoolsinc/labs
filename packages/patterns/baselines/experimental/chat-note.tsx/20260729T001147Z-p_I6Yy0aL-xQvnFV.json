{
  "pattern": "experimental/chat-note.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "default": "Chat Note",
        "asCell": [
          "cell"
        ]
      },
      "content": {
        "type": "string",
        "default": "",
        "asCell": [
          "cell"
        ]
      },
      "isHidden": {
        "type": "boolean",
        "default": false
      },
      "noteId": {
        "type": "string",
        "default": ""
      },
      "linkPattern": {
        "type": "string",
        "default": "",
        "asCell": [
          "cell"
        ],
        "description": "Pattern JSON for [[wiki-links]]. Defaults to creating new ChatNotes."
      },
      "parentNotebook": true,
      "model": {
        "type": "string",
        "default": "anthropic:claude-sonnet-4-5",
        "asCell": [
          "cell"
        ],
        "description": "Selected model for generation. Defaults to Sonnet 4.5"
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "mentioned": {
        "$ref": "#/$defs/AnonymousType_1",
        "default": []
      },
      "backlinks": {
        "$ref": "#/$defs/AnonymousType_1"
      },
      "parentNotebook": true,
      "content": {
        "type": "string",
        "default": ""
      },
      "isHidden": {
        "type": "boolean",
        "default": false
      },
      "noteId": {
        "type": "string",
        "default": ""
      },
      "isGenerating": {
        "type": "boolean"
      },
      "editContent": {
        "asCell": [
          "stream"
        ],
        "type": "object",
        "properties": {
          "detail": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "detail"
        ]
      },
      "$NAME": {
        "type": "string"
      },
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      }
    },
    "required": [
      "mentioned",
      "backlinks",
      "parentNotebook",
      "content",
      "isHidden",
      "noteId",
      "isGenerating",
      "editContent",
      "$UI"
    ],
    "description": "Represents a chat-enabled note with inline LLM conversations.",
    "$defs": {
      "AnonymousType_1": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/MentionablePiece"
        }
      },
      "MentionablePiece": {
        "type": "object",
        "properties": {
          "isHidden": {
            "type": "boolean"
          },
          "content": {
            "type": "string"
          },
          "mentioned": {
            "$ref": "#/$defs/AnonymousType_1"
          },
          "backlinks": {
            "$ref": "#/$defs/AnonymousType_1"
          },
          "$NAME": {
            "type": "string"
          }
        },
        "required": [
          "mentioned",
          "backlinks"
        ]
      }
    }
  }
}
