{
  "pattern": "experimental/folksonomy-tags.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {
      "scope": {
        "type": "string",
        "default": "",
        "asCell": [
          "cell"
        ],
        "description": "Namespace key (e.g., GitHub URL of the pattern using it)"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "asCell": [
          "cell"
        ],
        "description": "User's tags for this scope - bidirectional binding"
      },
      "aggregator": {
        "$ref": "#/$defs/AggregatorPiece",
        "description": "Optional: Direct reference to aggregator (bypasses wish() discovery)"
      }
    },
    "required": [
      "scope",
      "tags"
    ],
    "$defs": {
      "AggregatorPiece": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/TagEvent"
            }
          },
          "postEvent": {
            "$ref": "#/$defs/TagEvent",
            "asCell": [
              "stream"
            ]
          },
          "suggestions": {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CommunityTagSuggestion"
              }
            }
          }
        },
        "required": [
          "events",
          "postEvent",
          "suggestions"
        ]
      },
      "CommunityTagSuggestion": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string"
          },
          "count": {
            "type": "number"
          }
        },
        "required": [
          "tag",
          "count"
        ]
      },
      "TagEvent": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "action": {
            "enum": [
              "add",
              "use",
              "remove"
            ]
          },
          "timestamp": {
            "type": "number"
          }
        },
        "required": [
          "scope",
          "tag",
          "action",
          "timestamp"
        ]
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "addTag": {
        "asCell": [
          "stream"
        ],
        "type": "object",
        "properties": {
          "tag": {
            "type": "string"
          }
        },
        "required": [
          "tag"
        ]
      },
      "removeTag": {
        "asCell": [
          "stream"
        ],
        "type": "object",
        "properties": {
          "tag": {
            "type": "string"
          }
        },
        "required": [
          "tag"
        ]
      },
      "$NAME": {
        "type": "string"
      },
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      }
    },
    "required": [
      "tags",
      "addTag",
      "removeTag",
      "$NAME",
      "$UI"
    ]
  }
}
