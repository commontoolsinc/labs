{
  "pattern": "suggestable/people-list.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "people": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Person"
        }
      },
      "$NAME": {
        "type": "string"
      },
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      }
    },
    "required": [
      "people",
      "$NAME",
      "$UI"
    ],
    "$defs": {
      "Person": {
        "type": "object",
        "properties": {
          "contact": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "default": ""
              }
            },
            "required": [
              "name",
              "email"
            ]
          }
        },
        "required": [
          "contact"
        ]
      }
    }
  }
}
