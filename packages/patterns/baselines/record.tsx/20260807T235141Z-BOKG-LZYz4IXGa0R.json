            "required": [
              "index"
            ],
            "type": "object"
          },
          "setTitle": {
            "additionalProperties": false,
            "asCell": [
              "stream"
            ],
            "description": "Sets this record's title.",
            "properties": {
              "newTitle": {
                "type": "string"
              },
              "result": {
                "type": "unknown"
              }
            },
            "required": [
