      "TrashedSubPieceEntry": {
        "properties": {
          "collapsed": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "piece": {
            "type": "unknown"
          },
          "pinned": {
            "type": "boolean"
          },
          "trashedAt": {
