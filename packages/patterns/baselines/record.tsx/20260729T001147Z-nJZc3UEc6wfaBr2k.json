{
  "pattern": "record.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "default": ""
      },
      "subPieces": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/SubPieceEntry"
        },
        "default": []
      },
      "trashedSubPieces": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/TrashedSubPieceEntry"
        },
        "default": []
      }
    },
    "$defs": {
      "TrashedSubPieceEntry": {
        "type": "object",
        "properties": {
          "trashedAt": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          },
          "collapsed": {
            "type": "boolean"
          },
          "piece": {
            "type": "unknown"
          },
          "note": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "trashedAt",
          "type",
          "pinned",
          "piece"
        ]
      },
      "SubPieceEntry": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          },
          "collapsed": {
            "type": "boolean"
          },
          "piece": {
            "type": "unknown"
          },
          "note": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "pinned",
          "piece"
        ]
      }
    }
  },
  "resultSchema": {
    "$ref": "#/$defs/RecordOutput",
    "$defs": {
      "RecordOutput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "default": ""
          },
          "subPieces": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/SubPieceEntry"
            },
            "default": []
          },
          "trashedSubPieces": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/TrashedSubPieceEntry"
            },
            "default": []
          },
          "parentRecord": {
            "anyOf": [
              {
                "$ref": "#/$defs/RecordOutput"
              },
              {
                "type": "null"
              }
            ],
            "description": "Self-reference for sub-pieces to access their parent Record"
          },
          "addModule": {
            "asCell": [
              "stream"
            ],
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "initialData": {
                "type": "object",
                "properties": {},
                "additionalProperties": {
                  "type": "unknown"
                }
              },
              "result": {
                "type": "unknown"
              }
            },
            "required": [
              "type"
            ],
            "description": "Adds a module of the named type to this record's sub-pieces."
          },
          "getSummary": {
            "asCell": [
              "stream"
            ],
            "type": "object",
            "properties": {
              "result": {
                "type": "unknown"
              }
            },
            "description": "Writes a structured summary of every module into the result cell."
          },
          "updateModule": {
            "asCell": [
              "stream"
            ],
            "type": "object",
            "properties": {
              "index": {
                "type": "number"
              },
              "field": {
                "type": "string"
              },
              "value": {
                "type": "unknown"
              },
              "result": {
                "type": "unknown"
              }
            },
            "required": [
              "index",
              "field",
              "value"
            ],
            "description": "Sets a directly-settable field on the module at the given index."
          },
          "removeModule": {
            "asCell": [
              "stream"
            ],
            "type": "object",
            "properties": {
              "index": {
                "type": "number"
              },
              "result": {
                "type": "unknown"
              }
            },
            "required": [
              "index"
            ],
            "description": "Moves the module at the given index to the trash."
          },
          "setTitle": {
            "asCell": [
              "stream"
            ],
            "type": "object",
            "properties": {
              "newTitle": {
                "type": "string"
              },
              "result": {
                "type": "unknown"
              }
            },
            "required": [
              "newTitle"
            ],
            "description": "Sets this record's title."
          },
          "listModuleTypes": {
            "asCell": [
              "stream"
            ],
            "type": "object",
            "properties": {
              "result": {
                "type": "unknown"
              }
            },
            "description": "Writes the list of addable module types into the result cell."
          },
          "$NAME": {
            "type": "string"
          },
          "$UI": {
            "$ref": "https://commonfabric.org/schemas/vnode.json"
          }
        }
      },
      "TrashedSubPieceEntry": {
        "type": "object",
        "properties": {
          "trashedAt": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          },
          "collapsed": {
            "type": "boolean"
          },
          "piece": {
            "type": "unknown"
          },
          "note": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "trashedAt",
          "type",
          "pinned",
          "piece"
        ]
      },
      "SubPieceEntry": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          },
          "collapsed": {
            "type": "boolean"
          },
          "piece": {
            "type": "unknown"
          },
          "note": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "pinned",
          "piece"
        ]
      }
    }
  }
}
