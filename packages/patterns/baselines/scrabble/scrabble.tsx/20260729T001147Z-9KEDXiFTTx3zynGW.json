{
  "pattern": "scrabble/scrabble.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {
      "gameName": {
        "type": "string",
        "default": "Scrabble Match",
        "scope": "space"
      },
      "board": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/PlacedTile"
        },
        "default": [],
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ]
      },
      "bag": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Letter"
        },
        "default": [],
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ]
      },
      "bagIndex": {
        "type": "number",
        "default": 0,
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ]
      },
      "players": {
        "$ref": "#/$defs/PlayerRoster",
        "default": {
          "list": []
        },
        "scope": "space"
      },
      "gameEvents": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/GameEvent"
        },
        "default": [],
        "asCell": [
          {
            "kind": "cell",
            "scope": "space"
          }
        ]
      },
      "rack": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Letter"
        },
        "default": [],
        "asCell": [
          {
            "kind": "cell",
            "scope": "user"
          }
        ]
      },
      "placed": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/PlacedTile"
        },
        "default": [],
        "asCell": [
          {
            "kind": "cell",
            "scope": "user"
          }
        ]
      },
      "myName": {
        "type": "string",
        "default": "",
        "asCell": [
          {
            "kind": "cell",
            "scope": "user"
          }
        ]
      },
      "message": {
        "type": "string",
        "default": "",
        "asCell": [
          {
            "kind": "cell",
            "scope": "session"
          }
        ]
      }
    },
    "$defs": {
      "GameEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "join",
              "submit",
              "word",
              "system"
            ]
          },
          "player": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "timestamp": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "type",
          "player",
          "details",
          "timestamp"
        ]
      },
      "PlayerRoster": {
        "type": "object",
        "properties": {
          "list": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Player"
            }
          }
        },
        "required": [
          "list"
        ]
      },
      "Player": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string",
            "description": "Avatar URL or glyph, snapshotted from the joiner's shared profile."
          },
          "profile": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "avatar": {
                "type": "string"
              }
            },
            "asCell": [
              "cell"
            ],
            "description": "Live profile cell — present for profile-joined players (the scoreboard\nrenders it via `<cf-profile-badge>`), absent for headless name-only joins\n(test seam), which fall back to `<cf-avatar>`."
          },
          "color": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "joinedAt": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "color",
          "score",
          "joinedAt"
        ]
      },
      "Letter": {
        "type": "object",
        "properties": {
          "char": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "id": {
            "type": "string"
          },
          "isBlank": {
            "type": "boolean"
          }
        },
        "required": [
          "char",
          "points",
          "id",
          "isBlank"
        ]
      },
      "PlacedTile": {
        "type": "object",
        "properties": {
          "letter": {
            "$ref": "#/$defs/Letter"
          },
          "row": {
            "type": "number"
          },
          "col": {
            "type": "number"
          }
        },
        "required": [
          "letter",
          "row",
          "col"
        ]
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "myName": {
        "type": "string"
      },
      "board": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/PlacedTile"
        }
      },
      "bag": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Letter"
        }
      },
      "bagIndex": {
        "type": "number"
      },
      "players": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/PlayerView"
        }
      },
      "gameEvents": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/GameEvent"
        }
      },
      "rack": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Letter"
        }
      },
      "placed": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/PlacedTile"
        }
      },
      "message": {
        "type": "string"
      },
      "joinGame": {
        "asCell": [
          "stream",
          "opaque"
        ]
      },
      "joinWithName": {
        "asCell": [
          "stream"
        ],
        "type": "string"
      },
      "placeTile": {
        "asCell": [
          "stream"
        ],
        "type": "object",
        "properties": {
          "letterId": {
            "type": "string"
          },
          "row": {
            "type": "number"
          },
          "col": {
            "type": "number"
          }
        },
        "required": [
          "letterId",
          "row",
          "col"
        ]
      },
      "submitTurn": {
        "asCell": [
          "stream",
          "opaque"
        ]
      },
      "clearBoard": {
        "asCell": [
          "stream",
          "opaque"
        ]
      },
      "resetGame": {
        "asCell": [
          "stream",
          "opaque"
        ]
      }
    },
    "required": [
      "myName",
      "board",
      "bag",
      "bagIndex",
      "players",
      "gameEvents",
      "rack",
      "placed",
      "message",
      "joinGame",
      "joinWithName",
      "placeTile",
      "submitTurn",
      "clearBoard",
      "resetGame"
    ],
    "$defs": {
      "GameEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "join",
              "submit",
              "word",
              "system"
            ]
          },
          "player": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "timestamp": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "type",
          "player",
          "details",
          "timestamp"
        ]
      },
      "PlayerView": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string",
            "description": "Avatar URL or glyph, snapshotted from the joiner's shared profile."
          },
          "color": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "joinedAt": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "color",
          "score",
          "joinedAt"
        ]
      },
      "Letter": {
        "type": "object",
        "properties": {
          "char": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "id": {
            "type": "string"
          },
          "isBlank": {
            "type": "boolean"
          }
        },
        "required": [
          "char",
          "points",
          "id",
          "isBlank"
        ]
      },
      "PlacedTile": {
        "type": "object",
        "properties": {
          "letter": {
            "$ref": "#/$defs/Letter"
          },
          "row": {
            "type": "number"
          },
          "col": {
            "type": "number"
          }
        },
        "required": [
          "letter",
          "row",
          "col"
        ]
      }
    }
  }
}
