{
  "pattern": "shared-profile-roster/main.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {
      "roster": {
        "$ref": "#/$defs/Roster",
        "default": {
          "participants": []
        },
        "scope": "space",
        "description": "Shared roster — every user in the space reads & appends to this."
      },
      "viewer": {
        "$ref": "#/$defs/ViewerState",
        "default": {},
        "scope": "user",
        "description": "Current viewer's join marker — follows the user, not broadcast directly."
      }
    },
    "$defs": {
      "ViewerState": {
        "type": "object",
        "properties": {
          "joined": {
            "type": "boolean",
            "description": "Set once this viewer has contributed their entry to the shared roster."
          },
          "joinedName": {
            "type": "string",
            "description": "The display name shown on the join button after joining (cosmetic only)."
          }
        }
      },
      "Roster": {
        "type": "object",
        "properties": {
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Participant"
            },
            "default": []
          }
        },
        "required": [
          "participants"
        ]
      },
      "Participant": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "avatar": {
                "type": "string"
              }
            },
            "asCell": [
              "cell"
            ],
            "description": "Link to the contributor's profile cell — the stable identity key. Two\nparticipants are \"the same\" iff `equals()` matches on this, never on name."
          },
          "name": {
            "type": "string",
            "description": "Display name, snapshotted from the joiner's profile at join time."
          },
          "avatar": {
            "type": "string",
            "description": "Avatar URL or glyph, snapshotted from the joiner's profile (may be \"\")."
          },
          "joinedAt": {
            "type": "number"
          }
        },
        "required": [
          "profile",
          "name",
          "avatar",
          "joinedAt"
        ]
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "roster": {
        "$ref": "#/$defs/Roster",
        "default": {
          "participants": []
        },
        "scope": "space"
      },
      "viewer": {
        "$ref": "#/$defs/ViewerState",
        "default": {},
        "scope": "user"
      },
      "participantCount": {
        "type": "number"
      },
      "join": {
        "asCell": [
          "stream"
        ],
        "$ref": "#/$defs/JoinEvent"
      },
      "$NAME": {
        "type": "string"
      },
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      }
    },
    "required": [
      "roster",
      "viewer",
      "participantCount",
      "join",
      "$NAME",
      "$UI"
    ],
    "$defs": {
      "JoinEvent": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "ViewerState": {
        "type": "object",
        "properties": {
          "joined": {
            "type": "boolean",
            "description": "Set once this viewer has contributed their entry to the shared roster."
          },
          "joinedName": {
            "type": "string",
            "description": "The display name shown on the join button after joining (cosmetic only)."
          }
        }
      },
      "Roster": {
        "type": "object",
        "properties": {
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Participant"
            },
            "default": []
          }
        },
        "required": [
          "participants"
        ]
      },
      "Participant": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "avatar": {
                "type": "string"
              }
            },
            "description": "Link to the contributor's profile cell — the stable identity key. Two\nparticipants are \"the same\" iff `equals()` matches on this, never on name."
          },
          "name": {
            "type": "string",
            "description": "Display name, snapshotted from the joiner's profile at join time."
          },
          "avatar": {
            "type": "string",
            "description": "Avatar URL or glyph, snapshotted from the joiner's profile (may be \"\")."
          },
          "joinedAt": {
            "type": "number"
          }
        },
        "required": [
          "profile",
          "name",
          "avatar",
          "joinedAt"
        ]
      }
    }
  }
}
