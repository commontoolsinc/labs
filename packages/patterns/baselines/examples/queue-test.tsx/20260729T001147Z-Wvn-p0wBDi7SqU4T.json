{
  "pattern": "examples/queue-test.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "default": "Queue Test"
      }
    },
    "required": [
      "title"
    ]
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "$NAME": {
        "type": "string"
      },
      "$UI": {
        "$ref": "#/$defs/JSXElement"
      },
      "responses": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "pending": {
              "type": "boolean"
            },
            "result": {
              "type": [
                "string",
                "undefined"
              ]
            }
          },
          "required": [
            "pending",
            "result"
          ]
        }
      }
    },
    "required": [
      "$NAME",
      "$UI",
      "responses"
    ],
    "$defs": {
      "JSXElement": {
        "anyOf": [
          {
            "$ref": "https://commonfabric.org/schemas/vnode.json"
          },
          {
            "$ref": "#/$defs/UIRenderable"
          },
          {
            "type": "object",
            "properties": {}
          }
        ]
      },
      "UIRenderable": {
        "type": "object",
        "properties": {
          "$UI": {
            "$ref": "https://commonfabric.org/schemas/vnode.json"
          }
        },
        "required": [
          "$UI"
        ]
      }
    }
  }
}
