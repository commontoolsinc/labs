      "$NAME": {
        "type": "string"
      },
      "$UI": {
        "$ref": "#/$defs/JSXElement"
      },
      "$CHIP_UI": {
        "$ref": "#/$defs/JSXElement"
      },
      "$TILE_UI": {
        "$ref": "#/$defs/JSXElement"
      },
      "title": {
        "type": "string"
      }
    },
    "required": [
      "$NAME",
      "$UI",
      "$CHIP_UI",
      "$TILE_UI",
      "title"
    ],
    "$defs": {
      "JSXElement": {
        "anyOf": [
          {
            "$ref": "https://commonfabric.org/schemas/vnode.json"
          },
          {
            "$ref": "#/$defs/UIRenderable"
          },
          {
            "type": "object",
            "properties": {}
          }
        ]
      },
      "UIRenderable": {
        "type": "object",
        "properties": {
          "$UI": {
            "$ref": "https://commonfabric.org/schemas/vnode.json"
          }
        },
        "required": [
          "$UI"
        ]
      }
    }
  }
}
