{
  "pattern": "google/extractors/expect-response-followup.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {}
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "threads": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/TrackedThread"
        }
      },
      "threadCount": {
        "type": "number"
      },
      "dueCount": {
        "type": "number"
      }
    },
    "required": [
      "threads",
      "threadCount",
      "dueCount"
    ],
    "description": "Gmail expect-response follow-up manager. #expectResponseFollowup",
    "tags": [
      "expectresponsefollowup"
    ],
    "$defs": {
      "TrackedThread": {
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "lastMessageDate": {
            "type": "string"
          },
          "lastResponder": {
            "type": "string"
          },
          "daysSinceLastResponse": {
            "type": "number"
          },
          "pingCount": {
            "type": "number"
          },
          "emails": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ReadonlyEmail"
            }
          },
          "draftedFollowUp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "settings": {
            "$ref": "#/$defs/ThreadSettings"
          },
          "isDue": {
            "type": "boolean"
          },
          "shouldGiveUp": {
            "type": "boolean"
          },
          "lastMessageId": {
            "type": "string",
            "description": "Most recent message ID (for threading replies)"
          }
        },
        "required": [
          "threadId",
          "subject",
          "lastMessageDate",
          "lastResponder",
          "daysSinceLastResponse",
          "pingCount",
          "emails",
          "draftedFollowUp",
          "settings",
          "isDue",
          "shouldGiveUp",
          "lastMessageId"
        ]
      },
      "ThreadSettings": {
        "type": "object",
        "properties": {
          "context": {
            "$ref": "#/$defs/ThreadContext"
          },
          "daysThreshold": {
            "type": "number"
          },
          "maxPings": {
            "type": "number"
          }
        },
        "required": [
          "context",
          "daysThreshold",
          "maxPings"
        ]
      },
      "ThreadContext": {
        "enum": [
          "personal",
          "business",
          "urgent"
        ]
      },
      "ReadonlyEmail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "threadId": {
            "type": "string"
          },
          "labelIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "snippet": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "plainText": {
            "type": "string"
          },
          "htmlContent": {
            "type": "string"
          },
          "markdownContent": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "threadId",
          "labelIds",
          "snippet",
          "subject",
          "from",
          "date",
          "to",
          "plainText",
          "htmlContent",
          "markdownContent"
        ]
      }
    }
  }
}
