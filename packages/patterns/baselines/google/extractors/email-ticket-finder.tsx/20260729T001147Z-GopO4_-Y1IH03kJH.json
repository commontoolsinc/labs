{
  "pattern": "google/extractors/email-ticket-finder.tsx",
  "argumentSchema": {
    "type": "object",
    "properties": {
      "overrideAuth": {
        "$ref": "#/$defs/Auth",
        "asCell": [
          "cell"
        ]
      }
    },
    "$defs": {
      "Auth": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "default": ""
          },
          "tokenType": {
            "type": "string",
            "default": ""
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "expiresIn": {
            "type": "number",
            "default": 0
          },
          "expiresAt": {
            "type": "number",
            "default": 0
          },
          "refreshToken": {
            "type": "string",
            "default": ""
          },
          "user": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "picture": {
                "type": "string"
              }
            },
            "required": [
              "email",
              "name",
              "picture"
            ],
            "default": {
              "email": "",
              "name": "",
              "picture": ""
            }
          }
        },
        "required": [
          "token",
          "tokenType",
          "scope",
          "expiresIn",
          "expiresAt",
          "refreshToken",
          "user"
        ]
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "properties": {
      "tickets": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/TrackedTicket"
        }
      },
      "todayTickets": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/TrackedTicket"
        }
      },
      "upcomingTickets": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/TrackedTicket"
        }
      },
      "pastTickets": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/TrackedTicket"
        }
      },
      "todayCount": {
        "type": "number"
      },
      "upcomingCount": {
        "type": "number"
      },
      "$TILE_UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      }
    },
    "required": [
      "tickets",
      "todayTickets",
      "upcomingTickets",
      "pastTickets",
      "todayCount",
      "upcomingCount",
      "$TILE_UI"
    ],
    "description": "Email ticket finder for tracking upcoming events. #emailTickets",
    "tags": [
      "emailtickets"
    ],
    "$defs": {
      "TrackedTicket": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "eventName": {
            "type": "string"
          },
          "ticketSource": {
            "$ref": "#/$defs/TicketSource"
          },
          "eventDate": {
            "type": "string"
          },
          "eventTime": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "confirmationCode": {
            "type": "string"
          },
          "seatInfo": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/TicketStatus"
          },
          "daysUntil": {
            "type": "number"
          },
          "emailId": {
            "type": "string"
          },
          "emailDate": {
            "type": "string"
          },
          "emailSubject": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "eventName",
          "ticketSource",
          "status",
          "daysUntil",
          "emailId",
          "emailDate",
          "emailSubject"
        ]
      },
      "TicketStatus": {
        "enum": [
          "upcoming",
          "today",
          "past",
          "action_needed"
        ]
      },
      "TicketSource": {
        "enum": [
          "airline",
          "train",
          "bus",
          "concert",
          "sports",
          "theater",
          "movie",
          "hotel",
          "rental_car",
          "conference",
          "workshop",
          "restaurant",
          "tour",
          "other",
          "not_a_ticket"
        ]
      }
    }
  }
}
