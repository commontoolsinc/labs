{
  "argumentSchema": {
    "properties": {
      "labelsToAdd": {
        "default": [],
        "description": "Labels to add (by ID)",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "labelsToRemove": {
        "default": [],
        "description": "Labels to remove (by ID)",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "messageIds": {
        "default": [],
        "description": "Message ID(s) to manage labels for - can be single string or array",
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "messageIds",
      "labelsToAdd",
      "labelsToRemove"
    ],
    "type": "object"
  },
  "pattern": "google/core/experimental/gmail-label-manager.tsx",
  "resultSchema": {
    "$defs": {
      "GmailLabel": {
        "properties": {
          "id": {
            "description": "Label ID (use this for API calls)",
            "type": "string"
          },
          "labelListVisibility": {
            "description": "Label list visibility",
            "enum": [
              "labelShow",
              "labelShowIfUnread",
              "labelHide"
            ]
          },
          "messageListVisibility": {
            "description": "Message list visibility",
            "enum": [
              "show",
              "hide"
            ]
          },
          "name": {
            "description": "Label name (human readable)",
            "type": "string"
          },
          "type": {
            "description": "Label type: system, user",
            "enum": [
              "user",
              "system"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "type"
        ],
        "type": "object"
      },
      "OperationResult": {
        "properties": {
          "error": {
            "type": "string"
          },
          "messageCount": {
            "type": "number"
          },
          "success": {
            "type": "boolean"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "messageCount"
        ],
        "type": "object"
      }
    },
    "description": "Gmail label manager with confirmation. #gmailLabelManager",
    "properties": {
      "$UI": {
        "$ref": "https://commonfabric.org/schemas/vnode.json"
      },
      "availableLabels": {
        "description": "Available labels (fetched from Gmail)",
        "items": {
          "$ref": "#/$defs/GmailLabel"
        },
        "type": "array"
      },
      "labelsToAdd": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "labelsToRemove": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "messageIds": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "result": {
        "anyOf": [
          {
            "$ref": "#/$defs/OperationResult"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "messageIds",
      "labelsToAdd",
      "labelsToRemove",
      "result",
      "availableLabels",
      "$UI"
    ],
    "tags": [
      "gmaillabelmanager"
    ],
    "type": "object"
  }
