        type: "array"
      },
      index: {
        default: [],
        description: "The full-board survey surface: one bounded row per topic, carrying the\n" +
          "scalars a survey reads. A row IS its topic, so a row's own address is the\n" +
          "topic's — `--select index[].@` reads it, and an index into this array is\n" +
          "not a stable address.",
        items: { "$ref": "#/$defs/TopicIndexRow" },
        type: "array"
      },
      mentionable: {
        default: [],
        description: "The same list, under the name the topic pattern's editor autocompletes\n" +
          "over — what `addTopic` wires into each child as its mention universe.",
        items: { "$ref": "#/$defs/TopicPiece" },
        type: "array"
      },
      myName: { type: "string" },
